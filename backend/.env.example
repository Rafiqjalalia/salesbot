# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# Optional: path to a Chrome/Edge/Chromium browser.
# If unset, the app tries to auto-detect one (Chrome, Edge or Chromium).
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Security (change in production!)
JWT_SECRET=change-me-to-a-long-random-string

# Database - leave blank to use an automatic local database (works out of the box)
# For production set to your MongoDB connection string, e.g.:
# MONGODB_URI=mongodb://mongodb:27017/whatsflow
MONGODB_URI=

# Groq AI - REQUIRED. Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Admin bootstrap account created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
